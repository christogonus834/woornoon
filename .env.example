# Copy this file to .env in the same folder as docker-compose.yml, fill in real values, then run:
#   docker compose up --build

# Supabase project (Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI — primary provider
GEMINI_API_KEY=
GEMINI_MODEL=

# AI — backup provider (optional, recommended)
GROQ_API_KEY=
GROQ_MODEL=
